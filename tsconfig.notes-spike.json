{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "outDir": ".notes-spike-dist",
    "rootDir": ".",
    "paths": {}
  },
  "include": [
    "lib/auth.ts",
    "tests/auth.test.ts",
    "tests/auth-recovery.test.ts",
    "tests/dev-prod-isolation.test.ts",
    "lib/pedagogy/states.ts",
    "tests/support/migrated-db.ts",
    "tests/data-model.test.ts",
    "lib/pedagogy/transitions.ts",
    "tests/support/d1-sqlite.ts",
    "tests/audit-trail.test.ts",
    "lib/atlas-notes-document.ts",
    "lib/atlas-notes-input.ts",
    "tests/atlas-notes-document.test.ts",
    "tests/atlas-notes-input.test.ts",
    "tests/notes-recent-list.test.ts",
    "components/notes-panel-filters.ts",
    "tests/notes-panel-filters.test.ts",
    "tests/notes-workspace-structure.test.ts",
    "components/notes-coverage.ts",
    "tests/notes-coverage.test.ts",
    "lib/content-catalog.ts",
    "lib/catalog/roadmap-seed.ts",
    "tools/write-catalog-seed.ts",
    "lib/roadmap-store.ts",
    "tests/catalog-roadmap.test.ts",
    "lib/pedagogy/prerequisites.ts",
    "tests/prerequisites.test.ts",
    "lib/attachments.ts",
    "tests/attachments.test.ts",
    "tests/deploy-migrations.test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
